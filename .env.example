# GitHub Personal Access Token (read-only / public_repo scope is enough).
# Used to lift the unauthenticated rate limit (60/hr -> 5000/hr) when listing repos.
# Leave blank to fall back to anonymous GitHub API requests.
VITE_GITHUB_TOKEN=

# GitHub username whose public repositories should be listed (sorted by stars).
VITE_GITHUB_USERNAME=

# dev.to username whose published articles should be listed.
VITE_DEVTO_USERNAME=
